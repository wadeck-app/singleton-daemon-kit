package main

// resource.syso (Windows PE version info) is generated by goversioninfo from versioninfo.json.
// Run: goversioninfo -o resource.syso versioninfo.json

import (
	"os"
	"path/filepath"

	launcher "wadeck.ch/singleton-daemon-kit/go-launcher"
)

func main() {
	exe, _ := os.Executable()
	exeDir := filepath.Dir(exe)

	configDir := launcher.ResolveConfigDir(os.Args[1:], launcher.DefaultConfigDir("{{.DefaultConfigDir}}"))

	launcher.Run(launcher.Config{
		ConfigDir:  configDir,
		NodeScript: filepath.Join(exeDir, "{{.NodeScript}}"),
		AppName:    "{{.AppName}}",
		CLIFlags: []string{
{{range .CLIFlags}}			"{{.}}",
{{end}}		},
		SilentFlags: []string{
{{range .SilentFlags}}			"{{.}}",
{{end}}		},
	})
}
