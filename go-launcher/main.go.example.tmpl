// EXAMPLE consumer template — shows how to add custom argument parsing.
//
// Copy this file to your project and pass it as the third arg to build.sh:
//   bash build.sh launcher.config.json dist/ /path/to/this/main.go.tmpl
//
// The SDK's default main.go.tmpl does NOT parse args — it uses a fixed
// DefaultConfigDir. Use this example if your CLI needs:
//   - --config <dir>   named flag for multi-instance support
//   - <dir>            positional shorthand (e.g. myapp ~/.myapp2)
//   - or any other arg convention specific to your application

package main

// resource.syso (Windows PE version info) is generated by goversioninfo from versioninfo.json.
// Run: goversioninfo -o resource.syso versioninfo.json

import (
	"os"
	"path/filepath"
	"strings"

	launcher "wadeck.ch/singleton-daemon-kit/go-launcher"
)

// configDirFromArgs extracts the config directory from os.Args using this
// application's own conventions. Adapt as needed — the SDK does not dictate
// any flag naming or positional arg semantics.
func configDirFromArgs(args []string) string {
	// 1. --config <dir>  explicit named flag
	for i, arg := range args {
		if arg == "--config" && i+1 < len(args) {
			return args[i+1]
		}
		if strings.HasPrefix(arg, "--config=") {
			return strings.TrimPrefix(arg, "--config=")
		}
	}
	// 2. <dir>  first positional arg (multi-instance shorthand)
	for _, arg := range args {
		if !strings.HasPrefix(arg, "--") {
			return arg
		}
	}
	// 3. Default: ~/.{{.DefaultConfigDir}}
	return launcher.DefaultConfigDir("{{.DefaultConfigDir}}")
}

func main() {
	exe, _ := os.Executable()
	exeDir := filepath.Dir(exe)

	launcher.Run(launcher.Config{
		ConfigDir:  configDirFromArgs(os.Args[1:]),
		NodeScript: filepath.Join(exeDir, "{{.NodeScript}}"),
		AppName:    "{{.AppName}}",
		CLIFlags: []string{
{{range .CLIFlags}}			"{{.}}",
{{end}}		},
		SilentFlags: []string{
{{range .SilentFlags}}			"{{.}}",
{{end}}		},
	})
}
