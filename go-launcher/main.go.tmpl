package main

// resource.syso (Windows PE version info) is generated by goversioninfo from versioninfo.json.
// Run: goversioninfo -o resource.syso versioninfo.json

import (
	"os"
	"path/filepath"

	launcher "wadeck.ch/singleton-daemon-kit/go-launcher"
)

// This is the minimal reference template provided by the SDK.
// It resolves the config dir via the XDG standard, honouring --config <dir>,
// $XDG_CONFIG_HOME, and falling back to $HOME/.config/{{.DefaultConfigDir}}.
//
// Consumers that need additional argument parsing should provide their own
// main.go.tmpl and pass it as the third argument to build.sh:
//   bash build.sh launcher.config.json dist/ /path/to/custom/main.go.tmpl
func main() {
	exe, _ := os.Executable()
	// Resolve symlinks so exeDir points to the real binary directory, not the symlink's directory.
	if resolved, err := filepath.EvalSymlinks(exe); err == nil {
		exe = resolved
	}
	exeDir := filepath.Dir(exe)

	// ResolveConfigDir handles --config <dir>, $XDG_CONFIG_HOME, and legacy migration.
	// It returns the filtered args with "--config <dir>" removed so node does not see it.
	configDir, args := launcher.ResolveConfigDir("{{.DefaultConfigDir}}", os.Args[1:])

	launcher.Run(launcher.Config{
		ConfigDir:  configDir,
		Args:       args,
		NodeScript: filepath.Join(exeDir, "{{.NodeScript}}"),
		AppName:    "{{.AppName}}",
		CLIFlags: []string{
{{range .CLIFlags}}			"{{.}}",
{{end}}		},
		SilentFlags: []string{
{{range .SilentFlags}}			"{{.}}",
{{end}}		},
		UpdateCmd: []string{
{{range .UpdateCmd}}			"{{.}}",
{{end}}		},
	})
}
